    given-names: "İsmail Can"
    orcid: "https://orcid.org/0000-0002-7747-7777"
    affiliation: "İstinye University, Department of Electrical and Electronics Engineering"
repository-code: "https://github.com/DrCanD/dikmen-hlif-neuron-family-fpga-cuda"
license: Apache-2.0
version: "1.0.0"
date-released: "2026-05-15"
keywords:
  - spiking neural networks
  - neuromorphic computing
  - hazard function
  - TH-LIF
  - L-TH-LIF
  - FPGA
  - CUDA
  - edge AI
  - patent reference

